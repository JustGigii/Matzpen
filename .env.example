APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/personal_agent.db
TIMEZONE=Asia/Jerusalem

# Oracle Autonomous Database (used when DATABASE_URL=oracle+oracledb_async://@)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=

GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_AUDIO_MODEL=whisper-large-v3
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MAX_MEDIA_BYTES=18000000

OPENWA_BASE_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=
OPENWA_SIGNATURE_HEADER=X-OpenWA-Signature
OPENWA_WEBHOOK_MAX_BYTES=1048576

WHATSAPP_IGNORE_ARCHIVED=true
WHATSAPP_IGNORED_CHAT_IDS=
WHATSAPP_ARCHIVE_REFRESH_MINUTES=30
WHATSAPP_INITIAL_HISTORY_DAYS=7
WHATSAPP_HISTORY_MODE=review_only
WHATSAPP_HISTORY_MAX_MESSAGES=3000
WHATSAPP_HISTORY_MAX_MESSAGES_PER_CHAT=300
WHATSAPP_CONVERSATION_IDLE_SECONDS=120
WHATSAPP_URGENT_BYPASS_MINUTES=15
WHATSAPP_MAX_MEDIA_BYTES=18874368
WHATSAPP_EVENT_RETENTION_DAYS=30
WHATSAPP_DISCONNECT_WARNING_MINUTES=10
# Keep this off to avoid a Telegram prompt for every newly discovered WhatsApp group.
WHATSAPP_PROMPT_NEW_GROUPS=false

SHORTCUT_BEARER_TOKEN=

GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_TOKEN_FILE=
GOOGLE_CALENDAR_ID=primary

INTERNAL_ACTION_GRACE_SECONDS=60
DEFAULT_REMINDER_LEAD_MINUTES=15
PROACTIVE_CHECK_INTERVAL_SECONDS=60
CLARIFICATION_FALLBACK_MINUTES=10
APPROVAL_EXPIRY_HOURS=24
OVERDUE_GRACE_MINUTES=15
MORNING_BRIEF_FALLBACK_TIME=10:00
QUIET_HOURS_START=
QUIET_HOURS_END=

LOG_LEVEL=INFO
