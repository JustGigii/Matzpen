[Unit]
Description=Matzpen personal agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Keep the Gunicorn master compatible with the existing root-owned pid/log files.
# gunicorn_conf.py drops application workers to the unprivileged www account.
User=root
Group=root
WorkingDirectory=/www/wwwroot/Mazpen
ExecStart=/www/server/pyporject_evn/Mazen/bin/gunicorn -c /www/wwwroot/Mazpen/src/gunicorn_conf.py personal_agent.main:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=mixed
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
